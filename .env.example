# Geekatplay LoRA Maker configuration
# Geekatplay Studio - Vladimir Chopine
# Repository: https://github.com/GeekatplayStudio/LoraMaker.git
#
# IMPORTANT: this file is a reference only. The Studio does NOT load a .env
# file. Set these as environment variables (shell, or `set NAME=value` in
# start.bat) before launching. Values saved in the Settings tab
# (user_settings.json) take precedence over environment variables.
#
# Host and port are command-line flags, not variables:
#   python run_app.py --host 127.0.0.1 --port 7860 --no-browser

# ComfyUI folder that contains models/ (checkpoints, loras)
# COMFYUI_ROOT=D:/ComfyUI/ComfyUI

# Kohya sd-scripts: a kohya_ss checkout or its sd-scripts folder.
# KOHYA_SD_SCRIPTS_DIR is checked first when set. Without any Kohya install,
# SDXL trains with the built-in Diffusers/PEFT engine; FLUX.1 requires Kohya.
# KOHYA_SD_SCRIPTS_DIR=D:/kohya_ss/sd-scripts
# KOHYA_ROOT=D:/kohya_ss/sd-scripts
# KOHYA_FALLBACK_ROOT=D:/ComfyUI/lora-training/fluxgym/sd-scripts

# Local Ollama endpoint for captioning and chat
# OLLAMA_HOST=http://localhost:11434

# HuggingFace token for gated models such as FLUX.1 [dev] (read by huggingface_hub)
# HF_TOKEN=hf_your_token_here

# Test/CI only: allow the built-in trainer to run on CPU
# LORAMAKER_ALLOW_CPU_TRAINING=1
