# Geekatplay LoRA Maker Configuration
# Geekatplay Studio - Vladimir Chopine
# Repository: https://github.com/GeekatplayStudio/LoraMaker.git

# Host and Port binding
HOST=127.0.0.1
PORT=7860

# Ollama local inference endpoint
OLLAMA_HOST=http://localhost:11434

# Optional ComfyUI local endpoint for direct workflow dispatch
COMFYUI_HOST=http://127.0.0.1:8188

# Optional HuggingFace Token for gated models (FLUX.1-dev)
# HF_TOKEN=hf_your_token_here

# Kohya sd-scripts checkout (optional). When absent, SDXL trains with the built-in
# Diffusers/PEFT engine. FLUX.1 requires Kohya.
# KOHYA_ROOT=D:/kohya_ss/sd-scripts
# KOHYA_SD_SCRIPTS_DIR=D:/ComfyUI/lora-training/fluxgym/sd-scripts

# Test/CI only: let the built-in trainer run on CPU (used by tests/test_training_e2e.py).
# LORAMAKER_ALLOW_CPU_TRAINING=1
